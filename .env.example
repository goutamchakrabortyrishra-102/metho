META_WEBHOOK_VERIFY_TOKEN=replace-with-staging-webhook-token
META_APP_SECRET=replace-with-meta-app-secret
META_ACCESS_TOKEN=replace-with-page-access-token
META_GRAPH_API_VERSION=v20.0
META_CRM_DEFAULT_ASSIGNEE_ID=replace-with-existing-admin-user-id
META_PAGE_ID=replace-with-facebook-page-id
META_APP_ID=replace-with-meta-app-id
META_SETTINGS_ENCRYPTION_KEY=generate-a-fernet-key-and-store-server-side
# METHO AAY-UPAY ERP — Frontend Environment Variables
# Copy to `.env` and set to your backend's public URL.

# Public backend URL (must be reachable from the browser).
# Local dev:   http://localhost:8000
# Production:  https://api.yourdomain.com
REACT_APP_BACKEND_URL="https://metho-backend.onrender.com"

# Google Places API key for admin external lead generation (optional but recommended).
# If missing, lead search automatically falls back to the existing Overpass flow.
REACT_APP_GOOGLE_PLACES_API_KEY=""

