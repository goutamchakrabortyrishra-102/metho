# METHO AAY-UPAY ERP — Frontend Environment Variables
# Copy to `.env` and set to your backend's public URL.

# Public backend URL (must be reachable from the browser).
# Local dev:   http://localhost:8000
# Production:  https://api.yourdomain.com
REACT_APP_BACKEND_URL="https://metho-backend.onrender.com"

# Google Places API key for admin external lead generation (optional but recommended).
# If missing, lead search automatically falls back to the existing Overpass flow.
REACT_APP_GOOGLE_PLACES_API_KEY=""

